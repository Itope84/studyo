{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!library",
      "!fixtures",
      "!skills",
      "!**/.expo",
      "!**/*.gen.ts",
      "!**/expo-env.d.ts",
      "!**/public",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  }
}