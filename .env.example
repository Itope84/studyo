# Copy to .env (gitignored). Read by the server on start, including under launchd.
# STUDYO_ORIGINS=https://studyo.ilesan.me
# STUDYO_APP_URLS=
# STUDYO_PORT=8787
# STUDYO_ROOT=/path/to/library        (holds users/<id>/ and the server-wide _studyo/)
# Most AI runs at once across all users (work jobs, chat replies).
# STUDYO_MAX_WORK=2
# STUDYO_MAX_CHAT=3
# Where `pnpm users backup` puts archives.
# STUDYO_BACKUP_DIR=~/Backups/studyo
# Where invite links point (`pnpm users add`).
# STUDYO_INVITE_APP=https://studyo.ilesan.me
# STUDYO_INVITE_SERVER=https://studyo-api.ilesan.me
# Audio (Listen on a condensed doc). Free key from https://aistudio.google.com/ . Needs ffmpeg on PATH.
# GEMINI_API_KEY=
