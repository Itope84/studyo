// The web app on Cloudflare (Workers static assets). Build with `pnpm build:web`, deploy with `pnpm deploy:web`.
{
  "name": "studyo",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "routes": [{ "pattern": "studyo.ilesan.me", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
